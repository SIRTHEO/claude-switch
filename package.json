{
  "name": "@sirtheo/claude-switch",
  "version": "2.2.0",
  "description": "Switch between multiple Claude Code accounts instantly from the terminal — cross-platform CLI",
  "type": "module",
  "bin": {
    "claude": "dist/bin/cli.js"
  },
  "exports": {
    ".": "./dist/bin/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "multi-account",
    "switch",
    "account-switching",
    "anthropic",
    "cli",
    "credentials",
    "developer-tools"
  ],
  "author": {
    "name": "SIRTHEO",
    "url": "https://github.com/SIRTHEO"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SIRTHEO/claude-switch"
  },
  "bugs": {
    "url": "https://github.com/SIRTHEO/claude-switch/issues"
  },
  "homepage": "https://github.com/SIRTHEO/claude-switch#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/bin/",
    "dist/src/",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
