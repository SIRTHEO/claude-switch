{
  "name": "@sirtheo/claude-switch",
  "version": "2.6.1",
  "description": "Multi-account manager for Claude Code. Sign in once per account, switch instantly. Bypass Max/Pro rate limits with API key fallback and auto-revert. macOS · Linux · Windows.",
  "type": "module",
  "bin": {
    "claude": "dist/bin/cli.js"
  },
  "exports": {
    ".": "./dist/bin/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node -e \"require('fs').chmodSync('dist/bin/cli.js', 0o755)\"",
    "lint": "biome lint src bin test",
    "lint:fix": "biome lint --write --unsafe src bin test",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-cli",
    "anthropic",
    "anthropic-api",
    "multi-account",
    "account-switching",
    "switch-account",
    "oauth",
    "api-key",
    "fallback",
    "rate-limit",
    "max-plan",
    "pro-plan",
    "subscription",
    "usage",
    "statusline",
    "ccstatusline",
    "credentials",
    "keychain",
    "cli",
    "tui",
    "developer-tools",
    "productivity"
  ],
  "author": {
    "name": "SIRTHEO",
    "url": "https://github.com/SIRTHEO"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SIRTHEO/claude-switch"
  },
  "bugs": {
    "url": "https://github.com/SIRTHEO/claude-switch/issues"
  },
  "homepage": "https://github.com/SIRTHEO/claude-switch#readme",
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "dist/bin/",
    "dist/src/",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0"
  }
}
