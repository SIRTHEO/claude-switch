{
  "name": "@sirtheo/claude-switch",
  "version": "2.1.1",
  "description": "Instant multi-account switching for Claude Code — cross-platform",
  "type": "module",
  "bin": {
    "claude": "dist/bin/cli.js"
  },
  "exports": {
    ".": "./dist/bin/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude",
    "claude-code",
    "multi-account",
    "switch",
    "account-switching"
  ],
  "author": "SIRTHEO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SIRTHEO/claude-switch.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/bin/",
    "dist/src/",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
}
