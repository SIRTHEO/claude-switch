# ---------------------------------------------------------------------------
# claude-switch — root .gitignore
#
# Umbrella patterns; child .gitignore files (gui/, gui/src-tauri/) only
# list things scoped to themselves. Anything universal (node_modules,
# build output, OS junk, AI tooling, local notes) lives here and applies
# to the whole tree.
# ---------------------------------------------------------------------------

# Build output + dependency artifacts (anywhere in the tree)
node_modules/
dist/
build/
*.tsbuildinfo

# Mutation testing (Stryker) — sandbox + regenerable reports
.stryker-tmp/
reports/mutation/

# graphify knowledge graph — regenerable, local-only.
# Holds machine-specific absolute paths (.graphify_python/.graphify_root) that
# would trip the privacy gate; never a product surface. Rebuild with /graphify.
graphify-out/

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp

# AI assistant tool configs — local-only, never product surface.
# Exception: .claude/rules/ is tracked (project conventions, propagated to all clones).
.claude/*
!.claude/rules/
.claude-*
.harness*
.understand-*
hooks/
!src/ui/hooks/
CLAUDE.md
AGENTS.md
harness.toml

# Project-local notes — planning, brand context, internal experiments.
# Harness reads them; they never get pushed.
Plans.md
PRODUCT.md
DESIGN.md
EXPERIMENT.md
